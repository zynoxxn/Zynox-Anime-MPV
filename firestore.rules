rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // ZYNOX ANIME — HARDENED ZERO-TRUST RULES
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null &&
         request.auth.token.email_verified == true &&
         request.auth.token.email.lower() == 'zairoxmax2.0@gmail.com') ||
        userRole() == 'super_admin'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.admin == true ||
          request.auth.token.role in ['admin', 'super_admin'] ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          userRole() in ['admin', 'super_admin']
        )
      );
    }

    function isEditorOrAdmin() {
      return isAdmin() || (isAuthenticated() && userRole() == 'editor');
    }

    function isModeratorOrAdmin() {
      return isAdmin() || (isAuthenticated() && userRole() == 'moderator');
    }

    function isStaff() {
      return isAdmin() || (isAuthenticated() && userRole() in ['editor', 'moderator']);
    }

    function isValidViewsIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) &&
        request.resource.data.viewsCount is int &&
        request.resource.data.viewsCount >= resource.data.get('viewsCount', 0) &&
        request.resource.data.viewsCount <= resource.data.get('viewsCount', 0) + 5;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins registry - completely protected from client writes
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User profile documents: single-doc get allowed for public profiles/avatars; full listing restricted to admins
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100)) &&
        (!('bio' in request.resource.data) || request.resource.data.bio == null || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500));
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])) ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt', 'status']) &&
         (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100)) &&
         (!('bio' in request.resource.data) || request.resource.data.bio == null || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500)))
      );
      allow delete: if isSuperAdmin();
    }

    // Anime catalog (public reads ONLY published items; editors/admins can read & manage all)
    match /anime/{animeId} {
      allow read: if resource.data.get('published', true) != false || isEditorOrAdmin();
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || (
        resource.data.get('published', true) != false && isValidViewsIncrement()
      );
    }
    match /Anime/{animeId} {
      allow read: if resource.data.get('published', true) != false || isEditorOrAdmin();
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || (
        resource.data.get('published', true) != false && isValidViewsIncrement()
      );
    }
    match /animes/{animeId} {
      allow read: if resource.data.get('published', true) != false || isEditorOrAdmin();
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || (
        resource.data.get('published', true) != false && isValidViewsIncrement()
      );
    }

    // Episodes collection (public reads ONLY published episodes; editors/admins manage all)
    match /episodes/{episodeId} {
      allow read: if resource.data.get('published', true) != false || isEditorOrAdmin();
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || (
        resource.data.get('published', true) != false && isValidViewsIncrement()
      );
    }
    match /Episodes/{episodeId} {
      allow read: if resource.data.get('published', true) != false || isEditorOrAdmin();
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || (
        resource.data.get('published', true) != false && isValidViewsIncrement()
      );
    }
    match /episode/{episodeId} {
      allow read: if resource.data.get('published', true) != false || isEditorOrAdmin();
      allow create, delete: if isEditorOrAdmin();
      allow update: if isEditorOrAdmin() || (
        resource.data.get('published', true) != false && isValidViewsIncrement()
      );
    }

    // Watch Progress - Strict User Isolation
    match /watchProgress/{progressId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Watch History - Strict User Isolation
    match /watchHistory/{historyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Watchlist - Strict User Isolation
    match /watchlist/{watchlistId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Favorites - Strict User Isolation
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notifications - Strict Recipient Protection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() <= 128 &&
        (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200)) &&
        (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 1000));
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Community Anime Requests - Bounded size and enforced pending initial state
    match /animeRequests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAny(['title', 'animeTitle']) &&
        (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 200)) &&
        (!('animeTitle' in request.resource.data) || (request.resource.data.animeTitle is string && request.resource.data.animeTitle.size() >= 1 && request.resource.data.animeTitle.size() <= 200)) &&
        (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 2000)) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending') &&
        (!('userId' in request.resource.data) || request.resource.data.userId == null || (isAuthenticated() && request.resource.data.userId == request.auth.uid));
      allow update, delete: if isModeratorOrAdmin();
    }
    match /requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAny(['title', 'animeTitle']) &&
        (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 2000)) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending');
      allow update, delete: if isModeratorOrAdmin();
    }

    // Video Episode Problem Reports
    match /episodeReports/{reportId} {
      allow read: if isModeratorOrAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.keys().hasAny(['issueType', 'reason']) &&
        (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 2000)) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'open') &&
        (!('userId' in request.resource.data) || request.resource.data.userId == null || (isAuthenticated() && request.resource.data.userId == request.auth.uid));
      allow update, delete: if isModeratorOrAdmin();
    }
    match /reports/{reportId} {
      allow read: if isModeratorOrAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.keys().hasAny(['issueType', 'reason']) &&
        (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 2000)) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'open');
      allow update, delete: if isModeratorOrAdmin();
    }

    // Community Discussions & Comments
    match /comments/{commentId} {
      allow read: if resource.data.get('isHidden', false) != true ||
        isModeratorOrAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 1 &&
        request.resource.data.content.size() <= 1000 &&
        (!('likesCount' in request.resource.data) || request.resource.data.likesCount == 0) &&
        (!('isHidden' in request.resource.data) || request.resource.data.isHidden == false);
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'isEdited', 'updatedAt']) &&
         request.resource.data.content is string &&
         request.resource.data.content.size() >= 1 &&
         request.resource.data.content.size() <= 1000) ||
        isModeratorOrAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) &&
         request.resource.data.likesCount is int &&
         (request.resource.data.likesCount == resource.data.get('likesCount', 0) + 1 ||
          request.resource.data.likesCount == resource.data.get('likesCount', 0) - 1)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repliesCount']) &&
         request.resource.data.repliesCount is int &&
         request.resource.data.repliesCount == resource.data.get('repliesCount', 0) + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount']) &&
         request.resource.data.reportsCount is int &&
         request.resource.data.reportsCount == resource.data.get('reportsCount', 0) + 1)
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isModeratorOrAdmin());
    }

    // Comment Likes
    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isModeratorOrAdmin());
    }

    // Comment Reports
    match /commentReports/{reportId} {
      allow read: if isModeratorOrAdmin() || (isAuthenticated() && resource.data.reporterUserId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid;
      allow update, delete: if isModeratorOrAdmin();
    }

    // User Blocking
    match /userBlocks/{blockId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isModeratorOrAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isModeratorOrAdmin());
    }

    // Anime Follows
    match /animeFollows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isModeratorOrAdmin());
    }

    // System Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }

    // Global Editable Site Settings & Branding
    match /siteSettings/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS Collections
    match /cms_homepage_sections/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsHomepageSections/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_hero_banners/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsHeroBanners/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_schedule/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsSchedule/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_seasons/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsSeasons/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_genres/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsGenres/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_statuses/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsStatuses/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_years/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsYears/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_rating_ranges/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsRatingRanges/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsRatings/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_types/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsTypes/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_languages/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsLanguages/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_studios/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsStudios/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_navigation/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsNavigation/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_announcements/{docId} {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }
    match /cmsAnnouncements/{docId} {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }
    match /cms_seo_settings/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsSeoSettings/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_legal_pages/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsLegalPages/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_footer_config/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsFooterConfig/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_avatars/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cmsAvatars/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin();
    }
    match /cms_config/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin() || isModeratorOrAdmin();
    }
    match /cmsConfig/{docId} {
      allow read: if true;
      allow write: if isEditorOrAdmin() || isModeratorOrAdmin();
    }

    // Admin Audit / Activity Logs - IMMUTABLE
    match /admin_activity_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /cmsAdminLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /security_events/{eventId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['eventType']) &&
        request.resource.data.eventType is string &&
        request.resource.data.eventType.size() <= 100;
      allow update, delete: if false;
    }
  }
}
